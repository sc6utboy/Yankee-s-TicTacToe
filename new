void playerMove(char *spaces, char player) {
    int number;
    do {
        std::cout << "\033[33mEnter a spot to place a marker (1-9): \033[0m";
        std::cin >> number;
        number--;
        if (spaces[number] == ' ') {
            spaces[number] = player;
            break;
        }
    }while (!number > 0 or !number <8);

}
void compMove(char *spaces, char comp) {
    int number;
    srand(time(NULL));

    while (true) {
        number = rand() % 9;
        if (spaces[number] == ' ') {
            spaces[number] = comp;
            break;
        }
    }
}
