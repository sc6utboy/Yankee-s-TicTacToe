#include <iostream>
#include <ctime>


void drawBoard(char *spaces);
void playerMove(char *spaces, char player);
void compMove(char *spaces, char comp);
bool checkWinner(char *spaces, char player, char comp, std::string name);
bool checkTie(char *spaces);

int main() {
    char spaces[9] = {' ', ' ', ' ', ' ', ' ', ' ',' ', ' ', ' '};
    char player;
    char comp;
    bool running = true;

    drawBoard(spaces);
    std::string name;
    std::cout << "Enter your name: ";
    std::cin >> name;

    do {
        std::cout << "Enter your side (X/O): ";
        std::cin >> player;
    }while (player != 'X' and player != 'O');

    if (player == 'X') {
        comp = 'O';
    }
    else {
        comp = 'X';
    }

    while (running) {
        playerMove(spaces, player);
        drawBoard(spaces);
        if (checkWinner(spaces, player, comp, name)) {
            running = false;
            break;
        }
        else if (checkTie(spaces)) {
            running = false;
            break;
        }

        compMove(spaces, comp);
        drawBoard(spaces);
        if (checkWinner(spaces, player, comp, name)) {
            running = false;
            break;
        }
        else if (checkTie(spaces)) {
            running = false;
            break;
        }
        std::cout << "Thanks for playing!\n";
    }

    return 0;
}

